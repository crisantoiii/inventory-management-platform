@using InventoryPlatform.Infrastructure.Identity;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management Platform</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryPlatform.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Inventory Management Platform</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Dashboard/Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Products/Index">
                                Products
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Suppliers/Index">
                                Suppliers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Customers/Index">
                                Customers
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Categories/Index">
                                Categories
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/Units/Index">
                                Units
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-page="/InventoryTransactions/Index">
                                Inventory Transactions
                            </a>
                        </li>

                        @if (User.IsInRole(IdentityConstants.Roles.Administrator))
                            {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-page="/Administrator/Users/Index">
                                    Users
                                </a>
                            </li>
                            }

                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text me-3">
                                Hello, @User.Identity.Name
                            </span>

                            <form asp-area="Identity"
                                  asp-page="/Account/Logout"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button class="btn btn-outline-danger btn-sm">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity"
                               asp-page="/Account/Login"
                               class="btn btn-outline-primary">
                                Login
                            </a>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - InventoryPlatform.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
