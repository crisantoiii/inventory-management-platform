@using InventoryPlatform.Infrastructure.Identity;

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Management Platform</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/InventoryPlatform.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Inventory Management Platform</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <!-- Main Dashboard -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Dashboard/Index">Dashboard</a>
                        </li>

                        <!-- Core Management Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="coreDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Management
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="coreDropdown">
                                <li><a class="dropdown-item" asp-page="/Products/Index">Products</a></li>
                                <li><a class="dropdown-item" asp-page="/Categories/Index">Categories</a></li>
                                <li><a class="dropdown-item" asp-page="/Units/Index">Units</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-page="/Suppliers/Index">Suppliers</a></li>
                                <li><a class="dropdown-item" asp-page="/Customers/Index">Customers</a></li>
                            </ul>
                        </li>

                        <!-- Inventory & Purchasing Dropdown -->
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" id="inventoryDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Operations
                            </a>
                            <ul class="dropdown-menu" aria-labelledby="inventoryDropdown">
                                <li><a class="dropdown-item" asp-page="/Purchasing/PurchaseOrders/Index">Purchase Orders</a></li>
                                <li><a class="dropdown-item" asp-page="/InventoryTransactions/Index">Inventory Transactions</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item" asp-page="/Reports/InventoryValuation/Index">Inventory Valuation</a></li>
                                <li><a class="dropdown-item" asp-page="/Reports/SupplierPurchaseAnalysis/Index">Supplier Purchase Analysis</a></li>
                                <li><a class="dropdown-item" asp-page="/Reports/StockMovement/Index">Stock Movement</a></li>
                                <li><a class="dropdown-item" asp-page="/Reports/InventoryMovement/Index">Inventory Movement</a></li>
                                <li><a class="dropdown-item" asp-page="/Reports/LowStock/Index">Low Stock</a></li>
                            </ul>
                        </li>

                        <!-- Admin Controls -->
                        @if (User.IsInRole(IdentityConstants.Roles.Administrator))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger" asp-page="/Administrator/Users/Index">Users</a>
                            </li>
                        }

                        <!-- Global Policy -->
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Privacy</a>
                        </li>
                    </ul>

                    <!-- Authentication Status Section -->
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userMenuDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Hello, <strong>@User.Identity.Name</strong>
                                </a>
                            
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userMenuDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-page="/Account/Profile">
                                            My Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a asp-page="/Account/ChangePassword"
                                           class="dropdown-item">
                                            Change Password
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li class="d-flex justify-content-center py-2">
                                        <form asp-area="Identity"
                                              asp-page="/Account/Logout"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <button class="btn btn-outline-danger btn-sm">
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a asp-area="Identity"
                                   asp-page="/Account/Login"
                                   class="btn btn-outline-primary">
                                    Login
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - InventoryPlatform.Web - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
