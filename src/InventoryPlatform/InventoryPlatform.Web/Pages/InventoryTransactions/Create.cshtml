@page
@model InventoryPlatform.Web.Pages.InventoryTransactions.CreateModel

<h1>@ViewData["Title"]</h1>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Transaction.ProductId"
               class="form-label">Prodcut *</label>

        <select asp-for="Transaction.ProductId"
                asp-items="Model.ProductOptions"
                class="form-select">

            <option value="">
                -- Select Product --
            </option>

        </select>

        <span asp-validation-for="Transaction.ProductId"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Transaction.TransactionType"
               class="form-label">Transaction Type *</label>

        <select asp-for="Transaction.TransactionType"
                class="form-select"
                asp-items="Html.GetEnumSelectList<TransactionType>()">
        </select>

        <span asp-validation-for="Transaction.TransactionType"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Transaction.Quantity"
               class="form-label">Quantity *</label>

        <input asp-for="Transaction.Quantity"
               class="form-control" 
               type="number"
               min="1"
               step="0.01" />

        <span asp-validation-for="Transaction.Quantity"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Transaction.ReferenceNumber"
               class="form-label"></label>

        <input asp-for="Transaction.ReferenceNumber"
               class="form-control" maxlength="100" />

        <span asp-validation-for="Transaction.ReferenceNumber"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Transaction.Remarks"
               class="form-label"></label>

        <textarea asp-for="Transaction.Remarks"
                  class="form-control"
                  rows="3" maxlength="500"></textarea>

        <span asp-validation-for="Transaction.Remarks"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Transaction.TransactionDateUtc"
               class="form-label"></label>

        <input asp-for="Transaction.TransactionDateUtc"
               class="form-control"
               type="datetime" />

        <span asp-validation-for="Transaction.TransactionDateUtc"
              class="text-danger"></span>
    </div>

    <button class="btn btn-primary">
        Save
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>