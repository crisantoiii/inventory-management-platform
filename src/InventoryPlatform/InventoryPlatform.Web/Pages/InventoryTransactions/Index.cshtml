@page
@model InventoryPlatform.Web.Pages.InventoryTransactions.IndexModel
@using InventoryPlatform.Shared.Sorting;

@{
    var start = (Model.InventoryTransactions.Page - 1) * Model.InventoryTransactions.PageSize + 1;

    var end = Math.Min(
        Model.InventoryTransactions.Page * Model.InventoryTransactions.PageSize,
        Model.InventoryTransactions.TotalCount);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Inventory Transactions</h1>

    <a asp-page="Create"
       class="btn btn-primary">
        Add Transaction
    </a>
</div>
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @Model.SuccessMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
<form method="get">
    <div class="row g-3 align-items-end">
        <div class="col-md-6">
            <input asp-for="Filter.Search"
                   class="form-control"
                   placeholder="Search by product, SKU,  reference number, and remarks..." />
        </div>

        <div class="col-auto">
            <button class="btn btn-primary">
                Search
            </button>
        </div>

        <div class="col-auto">
            <a asp-page="Index"
               class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </div>
</form>

<p class="text-muted">
    Showing @start–@end of @Model.InventoryTransactions.TotalCount inventoryTransactions
</p>

@if (!Model.InventoryTransactions.Items.Any())
{
    <div class="alert alert-info">
        No inventory transactions found.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="TransactionDateUtc"
                       asp-route-Descending="@(Model.Filter.SortBy == InventoryTransactionSortFields.TransactionDateUtc && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Date
                    </a>
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="ProductName"
                       asp-route-Descending="@(Model.Filter.SortBy == InventoryTransactionSortFields.ProductName && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Product
                    </a>
                </th>
                <th>
                    SKU
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="TransactionType"
                       asp-route-Descending="@(Model.Filter.SortBy == InventoryTransactionSortFields.TransactionType && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Transaction
                    </a>
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="Quantity"
                       asp-route-Descending="@(Model.Filter.SortBy == InventoryTransactionSortFields.Quantity && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Quantity
                    </a>
                </th>
                <th>
                    Reference
                </th>
                <th>
                    Remarks
                </th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var inventoryTransaction in Model.InventoryTransactions.Items)
            {
                <tr>
                    <td>
                        @inventoryTransaction.TransactionDateUtc.ToLocalTime().ToString("dddd, MMMM dd, yyyy h:mm tt")
                    </td>
                    <td>
                        @inventoryTransaction.ProductName
                    </td>
                    <td>@inventoryTransaction.Sku</td>
                    <td>
                        @switch (inventoryTransaction.TransactionType)
                        {
                            case TransactionType.StockIn:
                                <span class="badge bg-success">Stock In</span>
                                break;

                            case TransactionType.StockOut:
                                <span class="badge bg-danger">Stock Out</span>
                                break;

                            case TransactionType.Adjustment:
                                <span class="badge bg-warning text-dark">Adjustment</span>
                                break;

                            default:
                                <span class="badge bg-secondary">Unknown</span>
                                break;
                        }
                    </td>
                    <td>
                        @if (inventoryTransaction.TransactionType == TransactionType.StockOut)
                        {
                            <span>-@inventoryTransaction.Quantity</span>
                        }
                        else
                        {
                            <span>+@inventoryTransaction.Quantity</span>
                        }
                    </td>
                    <td>@inventoryTransaction.ReferenceNumber</td>
                    <td>@inventoryTransaction.Remarks</td>
                    <td class="text-end">

                        <div class="btn-group" role="group">

                            <a asp-page="Details"
                               asp-route-id="@inventoryTransaction.Id"
                               asp-route-Page="@Model.Filter.Page"
                               asp-route-Search="@Model.Filter.Search"
                               asp-route-Status="@Model.Filter.Status"
                               asp-route-SortBy="@Model.Filter.SortBy"
                               asp-route-Descending="@Model.Filter.Descending" 
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>


                        </div>

                    </td>
                </tr>
            }

        </tbody>
    </table>
    <nav>

        <ul class="pagination">

            @if (Model.InventoryTransactions.HasPreviousPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="?Page=@(Model.InventoryTransactions.Page - 1)&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        Previous
                    </a>

                </li>
            }

            @for (int i = 1; i <= Model.InventoryTransactions.TotalPages; i++)
            {
                <li class="page-item @(i == Model.InventoryTransactions.Page ? "active" : "")">
                    <a class="page-link"
                       href="?Page=@i&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        @i
                    </a>

                </li>
            }

            @if (Model.InventoryTransactions.HasNextPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="?Page=@(Model.InventoryTransactions.Page + 1)&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        Next
                    </a>

                </li>
            }

        </ul>

    </nav>
}

