@page
@model InventoryPlatform.Web.Pages.Reports.InventoryValuation.IndexModel

@{
    ViewData["Title"] = "Inventory Valuation";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Inventory Valuation</h1>
            <p class="text-muted mb-0">
                Current inventory value based on quantity on hand and cost price.
            </p>
        </div>

        <a asp-page-handler="ExportToExcel"
           class="btn btn-outline-success">
            Export to Excel
        </a>
    </div>

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    @if (Model.Items.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            No inventory records are available.
        </div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="text-muted">Total Inventory Value</div>
                <h2 class="mb-0">
                    @Model.TotalInventoryValue.ToString("N2")
                </h2>
            </div>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Category</th>
                                <th class="text-end">Quantity On Hand</th>
                                <th class="text-end">Cost Price</th>
                                <th class="text-end">Inventory Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@item.ProductName</td>
                                    <td>@(item.CategoryName ?? "—")</td>
                                    <td class="text-end">
                                        @item.QuantityOnHand.ToString("N2")
                                    </td>
                                    <td class="text-end">
                                        @item.CostPrice.ToString("N2")
                                    </td>
                                    <td class="text-end">
                                        @item.InventoryValue.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot>
                            <tr class="fw-bold">
                                <td colspan="4" class="text-end">
                                    Total
                                </td>
                                <td class="text-end">
                                    @Model.TotalInventoryValue.ToString("N2")
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>