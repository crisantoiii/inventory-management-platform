@page
@model InventoryPlatform.Web.Pages.Reports.SupplierPurchaseAnalysis.IndexModel
@using InventoryPlatform.Domain.Enums
@using InventoryPlatform.Shared.Sorting

@{
    ViewData["Title"] = "Supplier Purchase Analysis";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Supplier Purchase Analysis</h1>

    <a asp-page-handler="ExportToExcel"
       asp-route-search="@Model.Search"
       asp-route-fromDate="@Model.FromDate"
       asp-route-toDate="@Model.ToDate"
       asp-route-status="@Model.Status"
       asp-route-sortBy="@Model.SortBy"
       asp-route-descending="@Model.Descending"
       class="btn btn-outline-success">
        Export to Excel
    </a>

    <a asp-page-handler="ExportToPdf"
       asp-route-search="@Model.Search"
       asp-route-fromDate="@Model.FromDate"
       asp-route-toDate="@Model.ToDate"
       asp-route-status="@Model.Status"
       asp-route-sortBy="@Model.SortBy"
       asp-route-descending="@Model.Descending"
       class="btn btn-outline-danger">
        Export to PDF
    </a>
</div>

<form method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label class="form-label" for="search">Supplier</label>
        <input class="form-control"
               id="search"
               name="search"
               value="@Model.Search"
               placeholder="Search supplier" />
    </div>

    <div class="col-md-2">
        <label class="form-label" for="fromDate">From date</label>
        <input class="form-control"
               id="fromDate"
               type="date"
               name="fromDate"
               value="@Model.FromDate?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-2">
        <label class="form-label" for="toDate">To date</label>
        <input class="form-control"
               id="toDate"
               type="date"
               name="toDate"
               value="@Model.ToDate?.ToString("yyyy-MM-dd")" />
    </div>

    <div class="col-md-2">
        <label class="form-label" for="status">Status</label>
        <select class="form-select" id="status" name="status">
            <option value="">All</option>

            @foreach (var status in Enum.GetValues<PurchaseOrderStatus>())
            {
                <option value="@status"
                        selected="@(string.Equals(
                                                Model.Status,
                                                status.ToString(),
                                                StringComparison.OrdinalIgnoreCase)
                                                ? "selected"
                                                : null)">
                    @status
                </option>
            }
        </select>
    </div>

    <div class="col-md-2 d-flex align-items-end">
        <button type="submit"
                class="btn btn-primary me-2">
            Filter
        </button>

        <a asp-page="./Index"
           class="btn btn-outline-secondary">
            Reset
        </a>
    </div>
</form>

@if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All"
         class="alert alert-danger"></div>
}

@if (Model.Result is null)
{
    <div class="alert alert-warning">
        Unable to load the report.
    </div>
}
else if (Model.Result.TotalCount == 0)
{
    <div class="alert alert-info">
        No supplier purchase data found for the selected criteria.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead>
                <tr>
                    <th>
                        <a asp-page="./Index"
                           asp-route-search="@Model.Search"
                           asp-route-fromDate="@Model.FromDate"
                           asp-route-toDate="@Model.ToDate"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@SupplierPurchaseAnalysisSortFields.Supplier"
                           asp-route-descending="@(Model.SortBy == SupplierPurchaseAnalysisSortFields.Supplier && !Model.Descending)"
                           asp-route-currentPage="1"
                           asp-route-pageSize="@Model.Result.PageSize">
                            Supplier
                        </a>
                    </th>

                    <th>
                        Purchase Period
                    </th>

                    <th>
                        <a asp-page="./Index"
                           asp-route-search="@Model.Search"
                           asp-route-fromDate="@Model.FromDate"
                           asp-route-toDate="@Model.ToDate"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@SupplierPurchaseAnalysisSortFields.PurchaseOrderCount"
                           asp-route-descending="@(Model.SortBy == SupplierPurchaseAnalysisSortFields.PurchaseOrderCount && !Model.Descending)"
                           asp-route-currentPage="1"
                           asp-route-pageSize="@Model.Result.PageSize">
                            PO Count
                        </a>
                    </th>

                    <th>
                        <a asp-page="./Index"
                           asp-route-search="@Model.Search"
                           asp-route-fromDate="@Model.FromDate"
                           asp-route-toDate="@Model.ToDate"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@SupplierPurchaseAnalysisSortFields.TotalQuantity"
                           asp-route-descending="@(Model.SortBy == SupplierPurchaseAnalysisSortFields.TotalQuantity && !Model.Descending)"
                           asp-route-currentPage="1"
                           asp-route-pageSize="@Model.Result.PageSize">
                            Ordered Qty
                        </a>
                    </th>

                    <th>
                        <a asp-page="./Index"
                           asp-route-search="@Model.Search"
                           asp-route-fromDate="@Model.FromDate"
                           asp-route-toDate="@Model.ToDate"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@SupplierPurchaseAnalysisSortFields.ReceivedQuantity"
                           asp-route-descending="@(Model.SortBy == SupplierPurchaseAnalysisSortFields.ReceivedQuantity && !Model.Descending)"
                           asp-route-currentPage="1"
                           asp-route-pageSize="@Model.Result.PageSize">
                            Received Qty
                        </a>
                    </th>

                    <th>
                        <a asp-page="./Index"
                           asp-route-search="@Model.Search"
                           asp-route-fromDate="@Model.FromDate"
                           asp-route-toDate="@Model.ToDate"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@SupplierPurchaseAnalysisSortFields.RemainingQuantity"
                           asp-route-descending="@(Model.SortBy == SupplierPurchaseAnalysisSortFields.RemainingQuantity && !Model.Descending)"
                           asp-route-currentPage="1"
                           asp-route-pageSize="@Model.Result.PageSize">
                            Remaining Qty
                        </a>
                    </th>

                    <th>
                        <a asp-page="./Index"
                           asp-route-search="@Model.Search"
                           asp-route-fromDate="@Model.FromDate"
                           asp-route-toDate="@Model.ToDate"
                           asp-route-status="@Model.Status"
                           asp-route-sortBy="@SupplierPurchaseAnalysisSortFields.TotalAmount"
                           asp-route-descending="@(Model.SortBy == SupplierPurchaseAnalysisSortFields.TotalAmount && !Model.Descending)"
                           asp-route-currentPage="1"
                           asp-route-pageSize="@Model.Result.PageSize">
                            Total Amount
                        </a>
                    </th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model.Result.Items)
                {
                    <tr>
                        <td>
                            @item.SupplierName
                        </td>

                        <td>
                            @if (item.FirstOrderDate == item.LastOrderDate)
                            {
                                @item.FirstOrderDate.ToString("MMM dd, yyyy")
                            }
                            else
                            {
                                @item.FirstOrderDate.ToString("MMM dd, yyyy")
                                @: –
                                @item.LastOrderDate.ToString("MMM dd, yyyy")
                            }
                        </td>

                        <td>
                            @item.PurchaseOrderCount
                        </td>

                        <td>
                            @item.TotalQuantity.ToString("N2")
                        </td>

                        <td>
                            @item.ReceivedQuantity.ToString("N2")
                        </td>

                        <td>
                            @item.RemainingQuantity.ToString("N2")
                        </td>

                        <td>
                            @item.TotalAmount.ToString("N2")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="d-flex justify-content-between align-items-center">
        <div>
            Page @Model.Result.Page of @Model.Result.TotalPages
            · @Model.Result.TotalCount supplier(s)
        </div>

        <div>
            @if (Model.Result.HasPreviousPage)
            {
                <a class="btn btn-outline-secondary me-2"
                   asp-page="./Index"
                   asp-route-search="@Model.Search"
                   asp-route-fromDate="@Model.FromDate"
                   asp-route-toDate="@Model.ToDate"
                   asp-route-status="@Model.Status"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-descending="@Model.Descending"
                   asp-route-currentPage="@(Model.Result.Page - 1)"
                   asp-route-pageSize="@Model.Result.PageSize">
                    Previous
                </a>
            }

            @if (Model.Result.HasNextPage)
            {
                <a class="btn btn-outline-secondary"
                   asp-page="./Index"
                   asp-route-search="@Model.Search"
                   asp-route-fromDate="@Model.FromDate"
                   asp-route-toDate="@Model.ToDate"
                   asp-route-status="@Model.Status"
                   asp-route-sortBy="@Model.SortBy"
                   asp-route-descending="@Model.Descending"
                   asp-route-currentPage="@(Model.Result.Page + 1)"
                   asp-route-pageSize="@Model.Result.PageSize">
                    Next
                </a>
            }
        </div>
    </div>
}