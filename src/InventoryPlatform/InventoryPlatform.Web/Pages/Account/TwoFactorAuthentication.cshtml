@page
@model InventoryPlatform.Web.Pages.Account.TwoFactorAuthenticationModel

@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title mb-3">
                        Two-Factor Authentication
                    </h2>

                    <p class="text-muted">
                        Add an authenticator app to provide an additional
                        layer of security for your account.
                    </p>

                    <div class="mb-3">
                        <strong>Status</strong>

                        @if (Model.TwoFactorEnabled)
                        {
                            <div class="text-success mt-1">
                                Enabled
                            </div>

                            <hr class="my-4" />

                            <form method="post"
                                  asp-page-handler="Disable"
                                  onsubmit="return confirm('Are you sure you want to disable two-factor authentication?');">

                                <button type="submit"
                                        class="btn btn-danger">
                                    Disable Two-Factor Authentication
                                </button>

                            </form>

                            <hr class="my-4" />

                            <h5>Recovery Codes</h5>

                            <p class="text-muted">
                                Recovery codes can be used if you lose access to
                                your authenticator app.
                            </p>

                            <form method="post"
                                  asp-page-handler="RegenerateRecoveryCodes"
                                  onsubmit="return confirm('Generating new recovery codes will invalidate your existing recovery codes. Continue?');">

                                <button type="submit"
                                        class="btn btn-outline-primary">
                                    Generate New Recovery Codes
                                </button>

                            </form>
                        }
                        else
                        {
                            <div class="text-muted mt-1">
                                Disabled
                            </div>

                            <div class="mt-3">
                                <a asp-page="/Account/TwoFactorSetup"
                                   class="btn btn-primary">
                                    Set Up Authenticator
                                </a>
                            </div>
                        }
                    </div>

                    <a asp-page="/Account/Profile"
                       class="btn btn-secondary ms-2">
                        Back to Profile
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>