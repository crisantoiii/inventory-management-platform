@page
@model InventoryPlatform.Web.Pages.Account.TwoFactorSetupModel

@{
    ViewData["Title"] = "Set Up Two-Factor Authentication";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h2 class="card-title mb-3">
                        Set Up Two-Factor Authentication
                    </h2>

                    <p class="text-muted">
                        Use an authenticator app such as Microsoft
                        Authenticator or Google Authenticator.
                    </p>

                    <h5 class="mt-4">
                        Step 1
                    </h5>

                    <p>
                        Add a new account in your authenticator app
                        and enter the following setup key:
                    </p>

                    <div class="alert alert-secondary">
                        <code class="user-select-all">
                            @Model.AuthenticatorKey
                        </code>
                    </div>

                    <p class="text-muted small">
                        Keep this key private. It is used to generate
                        your two-factor authentication codes.
                    </p>

                    <h5 class="mt-4">
                        Step 2
                    </h5>

                    <p>
                        After adding the account, enter the
                        six-digit verification code generated by
                        your authenticator app.
                    </p>

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>

                    <a asp-page="/Account/TwoFactorVerify"
                       class="btn btn-primary">
                        Continue
                    </a>

                    <a asp-page="/Account/TwoFactorAuthentication"
                       class="btn btn-secondary ms-2">
                        Cancel
                    </a>

                </div>
            </div>
        </div>
    </div>
</div>