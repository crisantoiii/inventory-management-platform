@page
@model InventoryPlatform.Web.Pages.Account.ProfileModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Profile</h1>
            <p class="text-muted mb-0">
                View your account information.
            </p>
        </div>
    </div>

    @if (TempData["StatusMessage"] is string statusMessage)
    {
        <div class="alert alert-success" role="alert">
            @statusMessage
        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert alert-danger" role="alert">
            @errorMessage
        </div>
    }

    @if (Model.Profile is not null)
    {
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Username</dt>
                    <dd class="col-sm-9">@Model.Profile.UserName</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Profile.Email</dd>

                    <dt class="col-sm-3">Phone Number</dt>
                    <dd class="col-sm-9">
                        @(string.IsNullOrWhiteSpace(Model.Profile.PhoneNumber)
                            ? "Not provided"
                            : Model.Profile.PhoneNumber)
                    </dd>

                    <dt class="col-sm-3">Email Verified</dt>
                    <dd class="col-sm-9">
                        @if (Model.Profile.EmailConfirmed)
                        {
                            <span>Yes</span>
                        }
                        else
                        {
                            <span>No</span>

                            <form method="post"
                                  asp-page="/Account/RequestEmailVerification"
                                  class="d-inline ms-2">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-primary">
                                    Verify Email
                                </button>
                            </form>
                        }
                    </dd>

                    <dt class="col-sm-3">Phone Verified</dt>
                    <dd class="col-sm-9">
                        @(Model.Profile.PhoneNumberConfirmed ? "Yes" : "No")
                    </dd>

                    <dt class="col-sm-3">Two-Factor Authentication</dt>
                    <dd class="col-sm-9">
                        @if (Model.Profile.TwoFactorEnabled)
                        {
                            <span class="text-success">
                                Enabled
                            </span>

                            <div class="mt-3">
                                <a asp-page="/Account/TwoFactorAuthentication"
                                   class="btn btn-primary">
                                    Manage Two-Factor Authentication
                                </a>
                            </div>
                        }
                        else
                        {
                            <span class="text-muted">
                                Disabled
                            </span>

                            <div class="mt-3">
                                <a asp-page="/Account/TwoFactorAuthentication"
                                   class="btn btn-primary">
                                    Set Up Two-Factor Authentication
                                </a>
                            </div>
                        }
                    </dd>

                </dl>
            </div>
        </div>
    }

    <hr class="my-4" />

    <h2 class="h4">Edit Profile</h2>

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="Input.PhoneNumber" class="form-label">
                Phone Number
            </label>

            <input asp-for="Input.PhoneNumber"
                   class="form-control"
                   autocomplete="tel" />

            <span asp-validation-for="Input.PhoneNumber"
                  class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>
    </form>

</div>