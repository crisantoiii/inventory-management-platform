@page
@model InventoryPlatform.Web.Pages.Account.RequestEmailVerificationModel
@{
    ViewData["Title"] = "Verify Email";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h1 class="h3 mb-3">Verify your email</h1>

                    <p class="text-muted">
                        Your email address has not been verified yet.
                        Click the button below to receive a verification email.
                    </p>

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"></div>

                    <form method="post">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            Send Verification Email
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <a asp-page="/Account/Profile">
                            Back to Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>