@page
@model InventoryPlatform.Web.Pages.Account.TwoFactorVerifyModel

@{
    ViewData["Title"] = "Verify Two-Factor Authentication";
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">

                    <h2 class="card-title mb-3">
                        Verify Two-Factor Authentication
                    </h2>

                    <p class="text-muted">
                        Enter the six-digit code generated by
                        your authenticator app.
                    </p>

                    <form method="post">

                        <div asp-validation-summary="All"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Code"
                                   class="form-label">
                                Verification Code
                            </label>

                            <input asp-for="Input.Code"
                                   class="form-control"
                                   autocomplete="one-time-code"
                                   inputmode="numeric"
                                   maxlength="6"
                                   placeholder="123456" />

                            <span asp-validation-for="Input.Code"
                                  class="text-danger">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-primary">
                            Verify and Enable
                        </button>

                        <a asp-page="/Account/TwoFactorSetup"
                           class="btn btn-secondary ms-2">
                            Back
                        </a>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>