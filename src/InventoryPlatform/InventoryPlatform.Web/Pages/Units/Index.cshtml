@page
@model InventoryPlatform.Web.Pages.Units.IndexModel
@using InventoryPlatform.Shared.Sorting;
@using InventoryPlatform.Infrastructure.Identity;

@{
    var start = (Model.Units.Page - 1) * Model.Units.PageSize + 1;

    var end = Math.Min(
        Model.Units.Page * Model.Units.PageSize,
        Model.Units.TotalCount);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    @if (User.IsInRole(IdentityConstants.Roles.Administrator) ||
    User.IsInRole(IdentityConstants.Roles.InventoryManager))
    {
        <a asp-page="Create"
           class="btn btn-primary">
            Add Unit
        </a>
    }
</div>
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @Model.SuccessMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
<form method="get">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <input asp-for="Filter.Search"
                   class="form-control"
                   placeholder="Search category name or description..." />
        </div>

        <div class="col-md-3">
            <select asp-for="Filter.Status"
                    class="form-select"
                    asp-items="Model.StatusOptions">
            </select>
        </div>

        <div class="col-auto">
            <button class="btn btn-primary">
                Search
            </button>
        </div>

        <div class="col-auto">
            <a asp-page="Index"
               class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </div>
</form>

<p class="text-muted">
    Showing @start–@end of @Model.Units.TotalCount categorys
</p>

@if (!Model.Units.Items.Any())
{
    <div class="alert alert-info">
        No categorys found.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="Code"
                       asp-route-Descending="@(Model.Filter.SortBy == UnitSortFields.Code && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Description
                    </a>
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="Name"
                       asp-route-Descending="@(Model.Filter.SortBy == UnitSortFields.Name && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Name
                    </a>
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="Description"
                       asp-route-Descending="@(Model.Filter.SortBy == UnitSortFields.Symbol && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Description
                    </a>
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="IsActive"
                       asp-route-Descending="@(Model.Filter.SortBy == UnitSortFields.IsActive && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Status
                    </a>
                </th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var unit in Model.Units.Items)
            {
                <tr>
                    <td>@unit.Code</td>
                    <td>
                        <a asp-page="Details"
                           asp-route-id="@unit.Id">
                            @unit.Name
                        </a>
                    </td>
                    <td>@unit.Symbol</td>
                    <td>@(unit.IsActive ? "Active" : "Inactive")</td>
                    <td class="text-end">

                        <div class="btn-group" role="group">

                            <a asp-page="Details"
                               asp-route-id="@unit.Id"
                               asp-route-Page="@Model.Filter.Page"
                               asp-route-Search="@Model.Filter.Search"
                               asp-route-Status="@Model.Filter.Status"
                               asp-route-SortBy="@Model.Filter.SortBy"
                               asp-route-Descending="@Model.Filter.Descending" 
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>

                            @if (User.IsInRole(IdentityConstants.Roles.Administrator) ||
                                User.IsInRole(IdentityConstants.Roles.InventoryManager))
                            {
                                <a asp-page="Edit"
                                   asp-route-id="@unit.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                            }

                            @if (User.IsInRole(IdentityConstants.Roles.Administrator))
                            {

                                @if (unit.IsActive)
                                {
                                    <a asp-page="Deactivate"
                                       asp-route-id="@unit.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Deactivate
                                    </a>
                                }
                                else
                                {
                                    <a asp-page="Activate"
                                       asp-route-id="@unit.Id"
                                       class="btn btn-sm btn-outline-success">
                                        Activate
                                    </a>
                                }
                            }

                        </div>

                    </td>
                </tr>
            }

        </tbody>
    </table>
    <nav>

        <ul class="pagination">

            @if (Model.Units.HasPreviousPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="?Page=@(Model.Units.Page - 1)&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        Previous
                    </a>

                </li>
            }

            @for (int i = 1; i <= Model.Units.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Units.Page ? "active" : "")">
                    <a class="page-link"
                       href="?Page=@i&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        @i
                    </a>

                </li>
            }

            @if (Model.Units.HasNextPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="?Page=@(Model.Units.Page + 1)&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        Next
                    </a>

                </li>
            }

        </ul>

    </nav>
}

