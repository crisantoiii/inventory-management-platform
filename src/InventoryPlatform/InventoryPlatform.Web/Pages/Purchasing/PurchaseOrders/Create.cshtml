@page
@model InventoryPlatform.Web.Pages.Purchasing.PurchaseOrders.CreateModel

@{
    ViewData["Title"] = "Create Purchase Order";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Create Purchase Order</h1>
            <p class="text-muted mb-0">
                Create a new purchase order.
            </p>
        </div>

        <a asp-page="./Index" class="btn btn-outline-secondary">
            Back to Purchase Orders
        </a>
    </div>

    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Purchase Order Information</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="PurchaseOrder.SupplierId"
                               class="form-label">
                            Supplier
                        </label>

                        <select asp-for="PurchaseOrder.SupplierId"
                                asp-items="Model.SupplierOptions"
                                class="form-select">
                            <option value="">Select supplier</option>
                        </select>

                        <span asp-validation-for="PurchaseOrder.SupplierId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PurchaseOrder.ExpectedDeliveryDate"
                               class="form-label">
                            Expected Delivery
                        </label>

                        <input asp-for="PurchaseOrder.ExpectedDeliveryDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="PurchaseOrder.ExpectedDeliveryDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="PurchaseOrder.Remarks"
                               class="form-label">
                            Remarks
                        </label>

                        <textarea asp-for="PurchaseOrder.Remarks"
                                  class="form-control"
                                  rows="3"></textarea>

                        <span asp-validation-for="PurchaseOrder.Remarks"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Purchase Order Items</h5>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="PurchaseOrder.Items[0].ProductId"
                               class="form-label">
                            Product
                        </label>

                        <select asp-for="PurchaseOrder.Items[0].ProductId"
                                asp-items="Model.ProductOptions"
                                class="form-select">
                            <option value="">Select product</option>
                        </select>

                        <span asp-validation-for="PurchaseOrder.Items[0].ProductId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="PurchaseOrder.Items[0].Quantity"
                               class="form-label">
                            Quantity
                        </label>

                        <input asp-for="PurchaseOrder.Items[0].Quantity"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="PurchaseOrder.Items[0].Quantity"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="PurchaseOrder.Items[0].UnitCost"
                               class="form-label">
                            Unit Cost
                        </label>

                        <input asp-for="PurchaseOrder.Items[0].UnitCost"
                               type="number"
                               step="0.01"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="PurchaseOrder.Items[0].UnitCost"
                              class="text-danger"></span>
                    </div>

                </div>

            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-page="./Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Create Purchase Order
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}