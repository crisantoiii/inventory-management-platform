@page
@model InventoryPlatform.Web.Pages.Purchasing.PurchaseOrders.CreateModel

@{
    ViewData["Title"] = "Create Purchase Order";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Create Purchase Order</h1>
            <p class="text-muted mb-0">
                Create a new purchase order.
            </p>
        </div>

        <a asp-page="./Index" class="btn btn-outline-secondary">
            Back to Purchase Orders
        </a>
    </div>

    <form method="post">

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3"></div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="mb-0">Purchase Order Information</h5>
            </div>

            <div class="card-body">
                <div class="row g-3">

                    <div class="col-md-6">
                        <label asp-for="PurchaseOrder.SupplierId"
                               class="form-label">
                            Supplier
                        </label>

                        <select asp-for="PurchaseOrder.SupplierId"
                                asp-items="Model.SupplierOptions"
                                class="form-select">
                            <option value="">Select supplier</option>
                        </select>

                        <span asp-validation-for="PurchaseOrder.SupplierId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="PurchaseOrder.ExpectedDeliveryDate"
                               class="form-label">
                            Expected Delivery
                        </label>

                        <input asp-for="PurchaseOrder.ExpectedDeliveryDate"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="PurchaseOrder.ExpectedDeliveryDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="PurchaseOrder.Remarks"
                               class="form-label">
                            Remarks
                        </label>

                        <textarea asp-for="PurchaseOrder.Remarks"
                                  class="form-control"
                                  rows="3"></textarea>

                        <span asp-validation-for="PurchaseOrder.Remarks"
                              class="text-danger"></span>
                    </div>

                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Purchase Order Items</h5>
                <button type="button"
                        id="add-item"
                        class="btn btn-outline-primary btn-sm">
                    Add Item
                </button>
            </div>

            <div class="card-body">
                <div id="purchase-order-items" class="vstack gap-3">
                    @for (var i = 0; i < Model.PurchaseOrder.Items.Count; i++)
                    {
                        <div class="purchase-order-item border rounded p-3"
                             data-item-row>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <h6 class="mb-0">Item <span data-item-number>@(i + 1)</span></h6>
                                <button type="button"
                                        class="btn btn-outline-danger btn-sm remove-item"
                                        aria-label="Remove item @(i + 1)">
                                    Remove
                                </button>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label asp-for="PurchaseOrder.Items[i].ProductId"
                                           class="form-label">
                                        Product
                                    </label>

                                    <select asp-for="PurchaseOrder.Items[i].ProductId"
                                            asp-items="Model.ProductOptions"
                                            class="form-select">
                                        <option value="">Select product</option>
                                    </select>

                                    <span asp-validation-for="PurchaseOrder.Items[i].ProductId"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="PurchaseOrder.Items[i].Quantity"
                                           class="form-label">
                                        Quantity
                                    </label>

                                    <input asp-for="PurchaseOrder.Items[i].Quantity"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />

                                    <span asp-validation-for="PurchaseOrder.Items[i].Quantity"
                                          class="text-danger"></span>
                                </div>

                                <div class="col-md-3">
                                    <label asp-for="PurchaseOrder.Items[i].UnitCost"
                                           class="form-label">
                                        Unit Cost
                                    </label>

                                    <input asp-for="PurchaseOrder.Items[i].UnitCost"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           class="form-control" />

                                    <span asp-validation-for="PurchaseOrder.Items[i].UnitCost"
                                          class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <p class="text-muted small mb-0 mt-3">
                    Add one row for each product included in this purchase order.
                </p>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-page="./Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn btn-primary">
                Create Purchase Order
            </button>
        </div>

    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const itemsContainer = document.getElementById("purchase-order-items");
            const addItemButton = document.getElementById("add-item");

            if (!itemsContainer || !addItemButton) {
                return;
            }

            const getRows = () =>
                Array.from(itemsContainer.querySelectorAll("[data-item-row]"));

            const updateRows = () => {
                const rows = getRows();

                rows.forEach((row, index) => {
                    row.querySelector("[data-item-number]").textContent = index + 1;

                    const removeButton = row.querySelector(".remove-item");
                    removeButton.disabled = rows.length === 1;
                    removeButton.setAttribute("aria-label", `Remove item ${index + 1}`);

                    row.querySelectorAll("[name]").forEach((element) => {
                        element.name = element.name.replace(
                            /PurchaseOrder\.Items\[\d+\]/,
                            `PurchaseOrder.Items[${index}]`);
                    });

                    row.querySelectorAll("[id]").forEach((element) => {
                        element.id = element.id.replace(
                            /PurchaseOrder_Items_\d+__/,
                            `PurchaseOrder_Items_${index}__`);
                    });

                    row.querySelectorAll("label[for]").forEach((label) => {
                        label.htmlFor = label.htmlFor.replace(
                            /PurchaseOrder_Items_\d+__/,
                            `PurchaseOrder_Items_${index}__`);
                    });

                    row.querySelectorAll("[data-valmsg-for]").forEach((message) => {
                        message.dataset.valmsgFor = message.dataset.valmsgFor.replace(
                            /PurchaseOrder\.Items\[\d+\]/,
                            `PurchaseOrder.Items[${index}]`);
                    });
                });
            };

            const clearClonedRow = (row) => {
                row.querySelectorAll("select").forEach((select) => {
                    select.selectedIndex = 0;
                });

                row.querySelectorAll("input").forEach((input) => {
                    input.value = "";
                });

                row.querySelectorAll(".field-validation-error, .field-validation-valid")
                    .forEach((message) => {
                        message.textContent = "";
                        message.classList.remove("field-validation-error");
                        message.classList.add("field-validation-valid");
                    });
            };

            addItemButton.addEventListener("click", () => {
                const rows = getRows();
                const template = rows[0];
                const newRow = template.cloneNode(true);

                clearClonedRow(newRow);
                itemsContainer.appendChild(newRow);
                updateRows();

                newRow.querySelector("select")?.focus();
            });

            itemsContainer.addEventListener("click", (event) => {
                const removeButton = event.target.closest(".remove-item");

                if (!removeButton) {
                    return;
                }

                const rows = getRows();

                if (rows.length === 1) {
                    return;
                }

                removeButton.closest("[data-item-row]")?.remove();
                updateRows();
            });

            updateRows();
        });
    </script>
}
