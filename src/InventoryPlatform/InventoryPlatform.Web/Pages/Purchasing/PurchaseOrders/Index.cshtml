@page
@model InventoryPlatform.Web.Pages.Purchasing.PurchaseOrders.IndexModel

@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Purchase Orders</h1>
            <p class="text-muted mb-0">
                View and manage purchase orders.
            </p>
        </div>

        <a asp-page="./Create" class="btn btn-primary">
            Create Purchase Order
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert alert-success" role="alert">
            @successMessage
        </div>
    }

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3"></div>

    <form method="get" class="row g-2 mb-4">
        <div class="col-md-4">
            <label for="search" class="form-label">Search purchase orders</label>
            <input asp-for="@Model.Search"
                   class="form-control"
                   placeholder="Search by purchase order ID or supplier"
                   autocomplete="off" />
        </div>

        <div class="col-md-2">
            <label for="FromDate" class="form-label">From date</label>
            <input asp-for="FromDate"
                   asp-format="{0:yyyy-MM-dd}"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <label for="ToDate" class="form-label">To date</label>
            <input asp-for="ToDate"
                   asp-format="{0:yyyy-MM-dd}"
                   type="date"
                   class="form-control" />
        </div>

        <div class="col-md-2">
            <label for="status" class="form-label">Status</label>
            <select asp-for="Status"
                    class="form-select"
                    asp-items="Model.StatusOptions">
            </select>
        </div>

        <div class="col-md-2 d-flex align-items-end">
            <div class="col-auto me-2">
                <button type="submit" class="btn btn-primary">
                    Filter
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Search) ||
                 Model.FromDate.HasValue ||
                 Model.ToDate.HasValue ||
                 Model.Status.HasValue)
            {
                <div class="col-auto">
                    <a asp-page="./Index"
                       class="btn btn-outline-secondary">
                        Reset
                    </a>
                </div>
            }
        </div>
    </form>

    @if (!Model.PurchaseOrders.Items.Any())
    {
        <div class="alert alert-info">
            No purchase orders found.
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a href="@Model.GetSortUrl(IndexModel.SortFields.Id)"
                                       class="text-decoration-none">
                                        ID
                                        @if (Model.SortBy == IndexModel.SortFields.Id)
                                        {
                                            <span aria-hidden="true">@(Model.Descending ? "↓" : "↑")</span>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="@Model.GetSortUrl(IndexModel.SortFields.Supplier)"
                                       class="text-decoration-none">
                                        Supplier
                                        @if (Model.SortBy == IndexModel.SortFields.Supplier)
                                        {
                                            <span aria-hidden="true">@(Model.Descending ? "↓" : "↑")</span>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="@Model.GetSortUrl(IndexModel.SortFields.OrderDate)"
                                       class="text-decoration-none">
                                        Order Date
                                        @if (Model.SortBy == IndexModel.SortFields.OrderDate)
                                        {
                                            <span aria-hidden="true">@(Model.Descending ? "↓" : "↑")</span>
                                        }
                                    </a>
                                </th>
                                <th>
                                    <a href="@Model.GetSortUrl(IndexModel.SortFields.Status)"
                                       class="text-decoration-none">
                                        Status
                                        @if (Model.SortBy == IndexModel.SortFields.Status)
                                        {
                                            <span aria-hidden="true">@(Model.Descending ? "↓" : "↑")</span>
                                        }
                                    </a>
                                </th>
                                <th class="text-end">
                                    <a href="@Model.GetSortUrl(IndexModel.SortFields.TotalAmount)"
                                       class="text-decoration-none">
                                        Total
                                        @if (Model.SortBy == IndexModel.SortFields.TotalAmount)
                                        {
                                            <span aria-hidden="true">@(Model.Descending ? "↓" : "↑")</span>
                                        }
                                    </a>
                                </th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var purchaseOrder in Model.PurchaseOrders.Items)
                            {
                                <tr>
                                    <td>
                                        @purchaseOrder.Id
                                    </td>

                                    <td>
                                        @purchaseOrder.SupplierName
                                    </td>

                                    <td>
                                        @purchaseOrder.OrderDate.ToString("MMM dd, yyyy")
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @purchaseOrder.Status
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        @purchaseOrder.TotalAmount.ToString("N2")
                                    </td>

                                    <td class="text-end">
                                        <a asp-page="./Details"
                                           asp-route-id="@purchaseOrder.Id"
                                           asp-route-search="@Model.Search"
                                           asp-route-fromDate="@Model.FromDate"
                                           asp-route-toDate="@Model.ToDate"
                                           asp-route-status="@Model.Status"
                                           asp-route-sortBy="@Model.SortBy"
                                           asp-route-descending="@Model.Descending"
                                           asp-route-page="@Model.PageNum"
                                           class="btn btn-sm btn-outline-primary">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <nav aria-label="Purchase order pagination" class="mt-3">
            <ul class="pagination">
                <li class="page-item @(Model.PageNum <= 1 ? "disabled" : "")">
                    @if (Model.PageNum > 1)
                    {
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-Search="@Model.Search"
                           asp-route-Status="@Model.Status"
                           asp-route-PageNum="@(Model.PageNum - 1)"                  
                           asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-SortBy="@Model.SortBy"
                           asp-route-Descending="@Model.Descending">
                            Previous
                        </a>
                    }
                    else
                    {
                        <span class="page-link">Previous</span>
                    }
                </li>
                @for (var pageNumber = 1; pageNumber <= Model.PurchaseOrders.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.PageNum ? "active" : "")">
                        <a class="page-link"
                           asp-page="./Index"
                           asp-route-Search="@Model.Search"
                           asp-route-Status="@Model.Status"
                           asp-route-PageNum="@pageNumber"                    
                           asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                           asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-SortBy="@Model.SortBy"
                           asp-route-Descending="@Model.Descending">
                            @pageNumber
                        </a>
                    </li>
                }

                <li class="page-item @(Model.PageNum >= Model.PurchaseOrders.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="./Index"
                       asp-route-Search="@Model.Search"
                       asp-route-Status="@Model.Status"
                       asp-route-PageNum="@(Model.PageNum + 1)"                      
                       asp-route-FromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                       asp-route-ToDate="@Model.ToDate?.ToString("yyyy-MM-dd")"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-SortBy="@Model.SortBy"
                       asp-route-Descending="@Model.Descending">
                        Next
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>
