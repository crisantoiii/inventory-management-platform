@page
@model InventoryPlatform.Web.Pages.Administrator.Users.IndexModel
@using InventoryPlatform.Shared.Sorting;
@using InventoryPlatform.Infrastructure.Identity;
@{
    var start = (Model.Users.Page - 1) * Model.Users.PageSize + 1;

    var end = Math.Min(
        Model.Users.Page * Model.Users.PageSize,
        Model.Users.TotalCount);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">@ViewData["Title"]</h1>

    @if (User.IsInRole(IdentityConstants.Roles.Administrator) ||
    User.IsInRole(IdentityConstants.Roles.InventoryManager))
    {
        <a asp-page="Create"
           class="btn btn-primary">
            Add User
        </a>
    }
</div>
@if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @Model.SuccessMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>
    </div>
}
<form method="get">
    <div class="row g-3 align-items-end">
        <div class="col-md-4">
            <input asp-for="Filter.Search"
                   class="form-control"
                   placeholder="Search by username, name, or email..." />
        </div>

        <div class="col-md-3">
            <select asp-for="Filter.Status"
                    class="form-select"
                    asp-items="Model.StatusOptions">
            </select>
        </div>

        <div class="col-auto">
            <button class="btn btn-primary">
                Search
            </button>
        </div>

        <div class="col-auto">
            <a asp-page="Index"
               class="btn btn-outline-secondary">
                Clear
            </a>
        </div>
    </div>
</form>

<p class="text-muted">
    Showing @start–@end of @Model.Users.TotalCount customers
</p>

@if (!Model.Users.Items.Any())
{
    <div class="alert alert-info">
        No customers found.
    </div>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="UserName"
                       asp-route-Descending="@(Model.Filter.SortBy == UserSortFields.UserName && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Username
                    </a>
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="Email"
                       asp-route-Descending="@(Model.Filter.SortBy == UserSortFields.Email && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Email
                    </a>
                </th>
                <th>
                      Roles
                </th>
                <th>
                    <a asp-page="./Index"
                       asp-route-SortBy="Lockout"
                       asp-route-Descending="@(Model.Filter.SortBy == UserSortFields.Lockout && !Model.Filter.Descending)"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-Status="@Model.Filter.Status"
                       asp-route-Page="1">
                        Status
                    </a>
                </th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var user in Model.Users.Items)
            {
                <tr>
                    <td>
                        <a asp-page="Details"
                           asp-route-id="@user.Id">
                            @user.UserName
                        </a>
                    </td>
                    <td>@user.Email</td>
                    <td>@string.Join(", ",user.Roles)</td>
                    <td>
                        @if (user.LockoutEnd is { } lockoutEnd &&
                             lockoutEnd > DateTimeOffset.UtcNow)
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td class="text-end">

                        <div class="btn-group" role="group">

                            <a asp-page="Details"
                               asp-route-id="@user.Id"
                               asp-route-Page="@Model.Filter.Page"
                               asp-route-Search="@Model.Filter.Search"
                               asp-route-Status="@Model.Filter.Status"
                               asp-route-SortBy="@Model.Filter.SortBy"
                               asp-route-Descending="@Model.Filter.Descending"
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>

                            @if (User.IsInRole(IdentityConstants.Roles.Administrator))
                            {
                                <a asp-page="Edit"
                                   asp-route-id="@user.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    Edit
                                </a>
                            }

                            @if (User.IsInRole(IdentityConstants.Roles.Administrator))
                            {

                                @if (user.LockoutEnabled)
                                {
                                    <a asp-page="Deactivate"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Deactivate
                                    </a>
                                }
                                else
                                {
                                    <a asp-page="Activate"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-success">
                                        Activate
                                    </a>
                                }
                            }

                        </div>

                    </td>
                </tr>
            }

        </tbody>
    </table>
    <nav>

        <ul class="pagination">

            @if (Model.Users.HasPreviousPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="?Page=@(Model.Users.Page - 1)&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        Previous
                    </a>

                </li>
            }

            @for (int i = 1; i <= Model.Users.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Users.Page ? "active" : "")">
                    <a class="page-link"
                       href="?Page=@i&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        @i
                    </a>

                </li>
            }

            @if (Model.Users.HasNextPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       href="?Page=@(Model.Users.Page + 1)&Search=@Model.Filter.Search&Status=@Model.Filter.Status&SortBy=@Model.Filter.SortBy&Descending=@Model.Filter.Descending">
                        Next
                    </a>

                </li>
            }

        </ul>

    </nav>
}

@section Scripts {
    <script>
        const backButton = document.getElementById("backButton");

        if (backButton) {
            backButton.addEventListener("click", function (e) {
                const referrer = document.referrer;
                const currentHost = window.location.host;

                // 1. Check if referrer exists and belongs to our website
                if (referrer && referrer.includes(currentHost)) {
                    
                    // Convert referrer to lowercase to make checks case-insensitive
                    const lowerReferrer = referrer.toLowerCase();

                    // 2. EXCEPTION: If we came from a Create or Edit page, do NOT use history.back()
                    if (lowerReferrer.includes("/create") || lowerReferrer.includes("/edit")) {
                        // Let the default HTML behavior run (it will follow asp-page="Index")
                        return; 
                    }

                    // 3. STANDARD BEHAVIOR: Safe to go back to previous details/pages
                    e.preventDefault();
                    window.history.back();
                }
                // 4. FALLBACK: If no referrer, it naturally follows asp-page="Index"
            });
        }
    </script>
}
