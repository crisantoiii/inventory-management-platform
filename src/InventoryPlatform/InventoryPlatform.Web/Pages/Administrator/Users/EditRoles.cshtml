@page "{id:Guid}"
@model InventoryPlatform.Web.Pages.Administrator.Users.EditRolesModel

<h1>@ViewData["Title"]</h1>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <input asp-for="Input.Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Input.Roles" class="form-label"></label>
        @foreach (var role in Model.RoleOptions)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="Input.Roles"
                       value="@role.Name"
                       checked="@role.Selected"
                       />

                <label class="form-check-label">
                    @role.Name
                </label>
            </div>
        }
    </div>

    <button class="btn btn-primary">
        Update
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>