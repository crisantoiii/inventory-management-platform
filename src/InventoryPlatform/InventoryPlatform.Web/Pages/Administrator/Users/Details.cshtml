@page
@model InventoryPlatform.Web.Pages.Administrator.Users.DetailsModel
@using InventoryPlatform.Infrastructure.Identity;

<h1>@ViewData["Title"]</h1>

<div class="card">
    <div class="card-body">

        <dl class="row">

            <dt class="col-sm-3">Username</dt>
            <dd class="col-sm-9">@Model.User.Username</dd>

            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.User.Email</dd>

            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@(Model.User.IsActive ? "Active" : "Inactive")</dd>

            <dt class="col-sm-3">Roles</dt>
            <dd class="col-sm-9">@string.Join(", ", @Model.User.Roles)</dd>

            <dt class="col-sm-3"></dt>
            <dd class="col-sm-9"></dd>

            <dt class="col-sm-3">Email Confirmed</dt>
            <dd class="col-sm-9">@Model.User.EmailConfirmed</dd>

            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.User.PhoneNumber</dd>

            <dt class="col-sm-3">Phone Confirmed</dt>
            <dd class="col-sm-9">@Model.User.PhoneNumberConfirmed</dd>

            <dt class="col-sm-3"></dt>
            <dd class="col-sm-9"></dd>

            <dt class="col-sm-3">Lockout Enabled</dt>
            <dd class="col-sm-9">@Model.User.LockoutEnabled</dd>

            <dt class="col-sm-3">Lockout End</dt>
            <dd class="col-sm-9">@Model.User.LockoutEnd</dd>

            <dt class="col-sm-3">Access Failed</dt>
            <dd class="col-sm-9">@Model.User.AccessFailedCount</dd>

        </dl>

        <div class="mt-4">

            <a asp-page="Index" id="backButton" class="btn btn-secondary">Back</a>

            @if (User.IsInRole(IdentityConstants.Roles.Administrator))
            {
                <a asp-page="Edit"
                   asp-route-id="@Model.User.Id"
                   class="btn btn-primary">
                    Edit
                </a>

                <a asp-page="AssignRoles"
                   asp-route-id="@Model.User.Id"
                   class="btn btn-info">
                    Assign Roles
                </a>
            }

        </div>

    </div>
</div>