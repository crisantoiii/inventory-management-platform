@page "{id:Guid}"
@model InventoryPlatform.Web.Pages.Administrator.Users.ResetPasswordModel

<h1>@ViewData["Title"]</h1>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <input asp-for="Input.Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="UserName" class="form-label fw-bold"></label>
        <span class="text-muted ms-1">@Model.UserName</span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label fw-bold"></label>
        <span class="text-muted ms-1">@Model.Email</span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.Password" class="form-label">New Password</label>
        <input asp-for="Input.Password" class="form-control" type="password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Input.ConfirmPassword" class="form-label"></label>
        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" />
        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
    </div>


    <button class="btn btn-primary">
        Reset Password
    </button>

    <a asp-page="Index"
       class="btn btn-secondary">
        Cancel
    </a>

</form>