@page "{id:int}"
@model InventoryPlatform.Web.Pages.Administrator.Groups.EditCapabilitiesModel

<h1>@ViewData["Title"]</h1>

<form method="post">

    <div asp-validation-summary="ModelOnly"
         class="text-danger"></div>

    <input asp-for="GroupId" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Capabilities</label>
        @foreach (var cap in Model.CapabilityOptions)
        {
            <div class="form-check">
                <input class="form-check-input"
                       type="checkbox"
                       name="SelectedCapabilityIds"
                       value="@cap.Id"
                       checked="@cap.Selected"
                       />

                <label class="form-check-label">
                    @cap.Name
                </label>
            </div>
        }
    </div>

    <button class="btn btn-primary">
        Update
    </button>

    <a asp-page="Details"
       asp-route-id="@Model.GroupId"
       class="btn btn-secondary">
        Cancel
    </a>

</form>
