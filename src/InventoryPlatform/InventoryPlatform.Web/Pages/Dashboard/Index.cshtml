@page
@model InventoryPlatform.Web.Pages.Dashboard.IndexModel
@{
}

<!-- Dashboard Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h2 m-0 text-dark">@ViewData["Title"]</h1>
    <button class="btn btn-primary btn-sm"><i class="bi bi-arrow-clockwise me-1"></i> Refresh</button>
</div>

<!-- Inventory Metrics Grid -->
<div class="row g-3 mb-5">
    <!-- Total Products -->
    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100 border-0 shadow-sm text-center">
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Total Products</div>
                <div class="fs-3 fw-bold text-dark">@Model.DashbordDTO.Statistics.TotalProducts</div>
            </div>
        </div>
    </div>

    <!-- Active Products -->
    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100 border-0 shadow-sm text-center border-start border-success border-4">
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Active</div>
                <div class="fs-3 fw-bold text-success">@Model.DashbordDTO.Statistics.ActiveProducts</div>
            </div>
        </div>
    </div>

    <!-- Inactive Products -->
    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100 border-0 shadow-sm text-center border-start border-secondary border-4">
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Inactive</div>
                <div class="fs-3 fw-bold text-secondary">@Model.DashbordDTO.Statistics.InactiveProducts</div>
            </div>
        </div>
    </div>

    <!-- Low Stock -->
    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100 border-0 shadow-sm text-center border-start border-warning border-4">
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Low Stock</div>
                <div class="fs-3 fw-bold text-warning">@Model.DashbordDTO.Statistics.LowStockProducts</div>
            </div>
        </div>
    </div>

    <!-- Out of Stock -->
    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100 border-0 shadow-sm text-center border-start border-danger border-4">
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div class="text-muted small text-uppercase fw-semibold mb-1">Out of Stock</div>
                <div class="fs-3 fw-bold text-danger">@Model.DashbordDTO.Statistics.OutOfStockProducts</div>
            </div>
        </div>
    </div>

    <!-- Inventory Value -->
    <div class="col-12 col-sm-6 col-md-4 col-lg-2">
        <div class="card h-100 border-0 shadow-sm text-center bg-primary text-white">
            <div class="card-body d-flex flex-column justify-content-center p-3">
                <div class="text-white-50 small text-uppercase fw-semibold mb-1">Value</div>
                <div class="fs-4 fw-bold">@Model.DashbordDTO.Statistics.InventoryValue</div>
            </div>
        </div>
    </div>
</div>

<!-- Lower Dashboard Sections -->
<div class="row g-4">
    <!-- Recent Transactions -->
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2 d-flex justify-content-between align-items-center">
                <h2 class="h5 m-0 fw-bold text-dark">Recent Transactions</h2>
                <a href="#" class="btn btn-link btn-sm p-0 text-decoration-none">View All</a>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-muted small uppercase">
                            <tr>
                                <th>ID</th>
                                <th>Product</th>
                                <th>Type</th>
                                <th>Qty</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-muted fw-medium">#TX-9402</td>
                                <td class="fw-semibold">Wireless Mouse</td>
                                <td><span class="badge bg-success-subtle text-success border border-success-subtle">Restock</span></td>
                                <td>+50</td>
                                <td class="text-muted small">Today, 2:15 PM</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-medium">#TX-9401</td>
                                <td class="fw-semibold">Mechanical Keyboard</td>
                                <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">Sale</span></td>
                                <td>-2</td>
                                <td class="text-muted small">Today, 11:30 AM</td>
                            </tr>
                            <tr>
                                <td class="text-muted fw-medium">#TX-9399</td>
                                <td class="fw-semibold">27" 4K Monitor</td>
                                <td><span class="badge bg-danger-subtle text-danger border border-danger-subtle">Sale</span></td>
                                <td>-1</td>
                                <td class="text-muted small">Yesterday</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Low Stock Products -->
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                <h2 class="h5 m-0 fw-bold text-dark">Low Stock Products</h2>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="d-flex flex-column gap-3">
                    <!-- Low Stock Item 1 -->
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded border border-warning-subtle">
                        <div>
                            <h6 class="mb-1 fw-semibold text-dark">USB-C Hub Adapter</h6>
                            <small class="text-muted">SKU: TECH-8832</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-warning text-dark mb-1">5 Left</span>
                            <div class="small text-muted">Min: 15</div>
                        </div>
                    </div>
                    <!-- Low Stock Item 2 -->
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded border border-warning-subtle">
                        <div>
                            <h6 class="mb-1 fw-semibold text-dark">Ergonomic Office Chair</h6>
                            <small class="text-muted">SKU: FURN-1029</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-warning text-dark mb-1">2 Left</span>
                            <div class="small text-muted">Min: 10</div>
                        </div>
                    </div>
                    <!-- Out of Stock Item -->
                    <div class="d-flex align-items-center justify-content-between p-3 bg-light rounded border border-danger-subtle">
                        <div>
                            <h6 class="mb-1 fw-semibold text-dark">Bluetooth Headphones</h6>
                            <small class="text-muted">SKU: AUDIO-4421</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-danger text-white mb-1">0 Left</span>
                            <div class="small text-muted">Min: 20</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
